# 唯一工作目录；Git 只维护可公开的项目代码。
/*
!/.gitignore
!/README.md
!/requirements.txt
!/console/
!/sources/
!/scripts/
!/tests/
!/打开闲鱼后台.cmd

/scripts/*
!/scripts/xianyu-console.py
!/scripts/xianyu_ops_core.py
!/scripts/xianyu-commerce.py
!/scripts/xianyu-quark.py
!/scripts/xianyu-support.py
!/scripts/xianyu-delivery-workflow.py
/tests/*
!/tests/public_fixtures.py
!/tests/test_owned_*.py
!/tests/test_delivery_workflow.py
!/tests/test_xianyu_ops_core.py

**/__pycache__/
*.pyc
*.local
*.tmp
*.log
*.sqlite
*.sqlite3
*.db
*.key
*.pem
.env
.env.*
/console/local-settings.json
# data、products、vendor、docs、upstream 和旧工程记录保留本机，不跟踪。
